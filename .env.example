# Every setting the project reads from the environment is documented here, with no real values.
# Copy this file to .env (git-ignored) and edit it. Never commit secrets.

# Execution mode. Allowed values: local, ci, cloud.
PIPELINE_MODE=local

# Ingestion: GBFS auto-discovery URL (ADR-0001). The default is the official Bicing feed.
GBFS_DISCOVERY_URL=https://barcelona.publicbikesystem.net/customer/gbfs/v3.0/gbfs.json
# Ingestion, local mode: folder where raw/ and quarantine/ files are written (git-ignored).
LOCAL_DATA_DIR=data
